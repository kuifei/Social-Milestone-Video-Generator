{
  "name": "milestone-video",
  "version": "0.1.0-alpha.2",
  "description": "English-first CLI for animated social-profile milestone videos, with Simplified Chinese closing captions.",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/kuifei/Social-Milestone-Video-Generator.git"},
  "homepage": "https://github.com/kuifei/Social-Milestone-Video-Generator#readme",
  "bugs": {"url": "https://github.com/kuifei/Social-Milestone-Video-Generator/issues"},
  "publishConfig": {"access": "public", "tag": "alpha", "registry": "https://registry.npmjs.org/"},
  "files": ["dist/", "examples/*.json", "examples/*.txt", ".env.example"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "milestone-video": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist', {recursive: true, force: true});\" && tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "studio": "remotion studio src/remotion/index.tsx"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
