{
  "name": "milestone-video",
  "version": "0.1.0-alpha.1",
  "description": "English-first CLI for animated social-profile milestone videos, with Simplified Chinese closing captions.",
  "license": "MIT",
  "private": true,
  "files": ["dist/", "src/", "test/", "examples/", "docs/", "tsconfig.json", ".env.example", "!examples/lauren/**"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "milestone-video": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "studio": "remotion studio src/remotion/index.tsx"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
